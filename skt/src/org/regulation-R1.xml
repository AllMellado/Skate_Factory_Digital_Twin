<?xml version="1.0" encoding="UTF-8"?>
<!--
  R1 - the initial regulation of the skateboard factory (scenario "regulation adaptation").

  Same vocabulary as factory-regulative-spec.xml (Gavel): norms, sanctions, ns-links. One norm is regulated here,
  n_complete_assembly ("every skateboard visits all four stations"). R1 only SANCTIONS it, and mildly:

    - nothing stops a skateboard from finishing early (no <skt:regimentation>): QC finds out afterwards
    - the fine is small next to what a missed deadline costs a time-pressed order

  The fine is in the same units as QualityPolicy's severity (a missed deadline weighs ~100 x the order's time focus),
  so a skateboard can compare "what I save by skipping a station" with "what it will cost me".

  R2 is not written by hand: the regulator agent derives it from R1 when the statistics say R1 does not work, and the
  regulation board writes it next to the other archives (factory-archive/regulation-R2.xml).
-->
<regulative-spec id="R1"
    xmlns="https://github.com/gavelproject/gavel"
    xmlns:skt="https://skt.local/regimentation">

  <norms>
    <norm id="n_complete_assembly">
      <activation>assembling(Skateboard)</activation>
      <issuer>quality_control</issuer>
      <target>Skateboard</target>
      <deactivation>false</deactivation>
      <deadline>order_status("FINISHED")</deadline>
      <content>obligation(all_stations_visited)</content>
    </norm>
  </norms>

  <sanctions>
    <sanction id="fine_incomplete_assembly">
      <activation>true</activation>
      <category>
        <purpose>punishment</purpose>
        <issuer>formal</issuer>
        <locus>other_directed</locus>
        <mode>direct</mode>
        <polarity>negative</polarity>
        <discernability>noticeable</discernability>
      </category>
      <content>fine(Target,20)</content>
    </sanction>
  </sanctions>

  <ns-links>
    <ns-link>
      <nid>n_complete_assembly</nid>
      <sid>fine_incomplete_assembly</sid>
    </ns-link>
  </ns-links>

  <!-- R1 regiments nothing. -->
  <skt:regimentations/>
</regulative-spec>
